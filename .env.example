DATABASE_URL="postgresql://baby:local_password@localhost:5433/baby_app?schema=public"

# Single-family login. Use a long, unique password in production.
APP_USERNAME="demo"
APP_PASSWORD="change-this-password"
APP_DISPLAY_NAME="Gia đình của tôi"

# Optional OpenAI-compatible provider. Without these, the assistant safely
# returns an insufficient-knowledge response instead of inventing an answer.
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
NOMINATIM_USER_AGENT="VaniFamily/0.1 (your-contact@example.com)"

# Optional Web Push reminders. Generate once with:
# npx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:your-email@example.com"
CRON_SECRET=""

# Optional internal WHO Anthro adapter; keep the token server-side only.
WHO_ANTHRO_URL="http://localhost:8082"
WHO_ANTHRO_TOKEN="change-this-token"
