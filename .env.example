DATABASE_URL="postgresql://baby:local_password@localhost:5433/baby_app?schema=public"
# Direct connection for Prisma migrations. On Neon, use the host without -pooler.
DATABASE_URL_UNPOOLED="postgresql://baby:local_password@localhost:5433/baby_app?schema=public"

# Single-family login. Use a long, unique password in production.
APP_USERNAME="demo"
APP_PASSWORD="change-this-password"
APP_DISPLAY_NAME="Gia đình của tôi"

# Optional OpenAI-compatible provider. Without these, the assistant safely
# returns an insufficient-knowledge response instead of inventing an answer.
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
NOMINATIM_USER_AGENT="VaniFamily/0.1 (your-contact@example.com)"

# Optional Neon Object Storage bucket (private) for mailbox photos/videos: videos up to 50 MB,
# uploaded straight from the device. Without these, media is stored in Postgres (4 MB per file).
# Endpoint/region: Neon Console > Connect > Storage. Keys: Settings > Credentials (storage:read +
# storage:write). Then allow browser uploads once: node --env-file=.env scripts/object-storage-cors.mjs <app origins>
# CSP reads the endpoint at build time, so redeploy after changing it.
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_REGION=""
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""

# Optional Web Push reminders. Generate once with:
# npx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:your-email@example.com"
CRON_SECRET=""

# Legacy standalone WHO R adapter only; the app now uses bundled LMS tables.
# Keep this token server-side if running the adapter for independent validation.
WHO_ANTHRO_URL="http://localhost:8082"
WHO_ANTHRO_TOKEN="change-this-token"
